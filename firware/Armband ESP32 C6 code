void addToAveragingBuffers(float bpm, float sbp, float dbp, float rr, float temp) {
    if (tx_state.sample_count < 10) { // Sized for 10 samples
        tx_state.bpm_samples[tx_state.sample_count] = bpm;
        tx_state.sbp_samples[tx_state.sample_count] = sbp;
        tx_state.dbp_samples[tx_state.sample_count] = dbp;
        tx_state.rr_samples[tx_state.sample_count] = rr;
        tx_state.temp_samples[tx_state.sample_count] = temp;
        tx_state.sample_count++;
    }
}

float calculateAverage(float* samples, int count) {
    if (count == 0) return 0;
    float sum = 0;
    int valid_count = 0;
    for (int i = 0; i < count; i++) {
        if (samples[i] > 0) {
            sum += samples[i];
            valid_count++;
        }
    }
    return (valid_count > 0) ? (sum / valid_count) : 0;
}

void resetAveragingBuffers() {
    tx_state.sample_count = 0;
    for (int i=0; i<10; ++i) {
        tx_state.bpm_samples[i] = 0;
        tx_state.sbp_samples[i] = 0;
        tx_state.dbp_samples[i] = 0;
        tx_state.rr_samples[i] = 0;
        tx_state.temp_samples[i] = 0;
    }
}

void sendHealthData() {
    HealthData41 data;
    data.user_id = 1;
    data.timestamp = millis();
    data.emergency = emergencyPressed ? 1 : 0;

    data.bpm = system_status.ecg_electrodes_ok ? (int)calculateAverage(tx_state.bpm_samples, tx_state.sample_count) : 0;
    data.blood_pressure_sbp = system_status.ecg_electrodes_ok ? (int)calculateAverage(tx_state.sbp_samples, tx_state.sample_count) : 0;
    data.blood_pressure_dbp = system_status.ecg_electrodes_ok ? (int)calculateAverage(tx_state.dbp_samples, tx_state.sample_count) : 0;
    data.respiratory_rate = system_status.ecg_electrodes_ok ? (int)calculateAverage(tx_state.rr_samples, tx_state.sample_count) : 0;
    data.lead_off = system_status.ecg_electrodes_ok ? 0 : 1;
    data.temperature = system_status.temp_sensor_ok ? calculateAverage(tx_state.temp_samples, tx_state.sample_count) : 0;
    data.activeness = system_status.imu_ok ? ((ActivityState == ACT_MOTION) ? 1 : 0) : 0;

    // LOGIC CORRECTION: 'fall_detected' is only 1 if a recovery has timed out
    int fall_status = 0;
    if (system_status.imu_ok && fallRecoveryState == REC_TIMEOUT) {
        if (millis() < fallOutputUntil) { // Use the timer set when timeout occurred
             fall_status = 1;
        } else {
             fallRecoveryState = REC_NONE; // Clear status after alert period
        }
    }
    data.fall_detected = fall_status;

    Serial.println("----------------------------------------");
    Serial.print("[ESP-NOW SENDING] ");
    Serial.print("BPM: "); Serial.print(data.bpm);
    Serial.print(", BP: "); Serial.print(data.blood_pressure_sbp);
    Serial.print("/"); Serial.print(data.blood_pressure_dbp);
    Serial.print(", RR: "); Serial.print(data.respiratory_rate);
    Serial.print(", Temp: "); Serial.print(data.temperature, 1);
    Serial.print(", LO: "); Serial.print(data.lead_off);
    Serial.print(", Motion: "); Serial.print(data.activeness);
    Serial.print(", Fall: "); Serial.print(data.fall_detected);
    Serial.print(", EMG: "); Serial.println(data.emergency);
    
    if (esp_now_send(receiverMAC, (uint8_t*)&data, sizeof(data)) == ESP_OK) {
        Serial.println("[OK] Transmission successful.");
    } else {
        Serial.println("[FAIL] Transmission failed.");
    }
    Serial.println("----------------------------------------");

    resetAveragingBuffers();
}

void sendEmergencyData(uint8_t emg_val) {
    EmgEvent emg_data;
    emg_data.user_id = 1;
    emg_data.emg = emg_val;
    emg_data.ts_ms = millis();

    esp_err_t result = esp_now_send(receiverMAC, (uint8_t*)&emg_data, sizeof(emg_data));
    if (result == ESP_OK) {
        Serial.printf("⚡ EMG FAST-PATH SENT: %d\n", emg_val);
    } else {
        Serial.println("[FAIL] Emergency packet send failed.");
    }
}

void handleDataTransmission() {
    unsigned long now = millis();
    static bool emgPrev = false;

    if (!tx_state.calibration_complete) {
        if (now - tx_state.system_start_time >= CALIBRATION_TIME_MS) {
            tx_state.calibration_complete = true;
            Serial.println("[INFO] System calibration complete. Starting data transmission.");
        } else {
            return;
        }
    }
    
    // Regular 10-second health data
    if (now - tx_state.last_transmission >= TRANSMISSION_INTERVAL_MS) {
        sendHealthData();
        tx_state.last_transmission = now;
    }

    // High-priority emergency data fast-path
    if (emergencyPressed && !emgPrev) { // Rising edge, send immediately
        sendEmergencyData(1);
        tx_state.last_emergency_transmission = now;
    } else if (emergencyPressed && (now - tx_state.last_emergency_transmission >= EMERGENCY_SEND_PERIOD_MS)) { // Continue sending every second
        sendEmergencyData(1);
        tx_state.last_emergency_transmission = now;
    } else if (!emergencyPressed && emgPrev) { // Falling edge, send one clear message
        sendEmergencyData(0);
    }
    emgPrev = emergencyPressed;
}

