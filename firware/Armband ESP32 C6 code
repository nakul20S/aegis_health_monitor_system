// --- UTILITY ---
static inline float vecMagG(float x, float y, float z) { return sqrtf(x*x + y*y + z*z); }
static inline float dot3(const Vec3 &a, const Vec3 &b) { return a.x*b.x + a.y*b.y + a.z*b.z; }
static float angleDegBetweenVecsSafe(const Vec3 &a, const Vec3 &b) {
  float magA = vecMagG(a.x, a.y, a.z);
  float magB = vecMagG(b.x, b.y, b.z);
  if (magA < 1e-6f || magB < 1e-6f) return 180.0f;
  float d = dot3(a,b) / (magA * magB);
  if (d > 1.0f) d = 1.0f; else if (d < -1.0f) d = -1.0f;
  return acosf(d) * 180.0f / 3.14159265f;
}
static inline void pushRing(float ax, float ay, float az, unsigned long t) {
    ringHead = (ringHead + 1) % RING_BUF_LEN;
    ring[ringHead] = {ax, ay, az, t};
    if (ringCount < RING_BUF_LEN) ringCount++;
}
static Vec3 avgRingBetween(unsigned long t0, unsigned long t1) {
    Vec3 s = {0.0f,0.0f,0.0f,0};
    int c = 0;
    for (int i = 0; i < ringCount; ++i) {
        int idx = (ringHead - i + RING_BUF_LEN) % RING_BUF_LEN;
        if (ring[idx].t >= t0 && ring[idx].t <= t1) {
            s.x += ring[idx].x; s.y += ring[idx].y; s.z += ring[idx].z; ++c;
        }
    }
    if (c > 0) { s.x /= c; s.y /= c; s.z /= c; }
    return s;
}
float lerp(float x0, float y0, float x1, float y1, float x) {
    if (x1 == x0) return y0;
    return y0 + (y1 - y0) * (x - x0) / (x1 - x0);
}


// --- IMU & MOTION ---
bool processIMU(float& accelX, float& accelY, float& accelZ, float& gyroX, float& gyroY, float& gyroZ) {
    if (!system_status.imu_ok) return false;

    if (!myICM.dataReady()) return false;
    myICM.getAGMT();
    if (myICM.status != ICM_20948_Stat_Ok) {
        Serial.println("[WARN] IMU read failed, disabling sensor.");
        system_status.imu_ok = false;
        return false;
    }

    float rawAx_mg = myICM.accX(), rawAy_mg = myICM.accY(), rawAz_mg = myICM.accZ();
    float rawGx = myICM.gyrX(), rawGy = myICM.gyrY(), rawGz = myICM.gyrZ();

    accelX = ACCEL_SMOOTH_ALPHA * (rawAx_mg / 1000.0f) + (1.0f - ACCEL_SMOOTH_ALPHA) * accelX;
    accelY = ACCEL_SMOOTH_ALPHA * (rawAy_mg / 1000.0f) + (1.0f - ACCEL_SMOOTH_ALPHA) * accelY;
    accelZ = ACCEL_SMOOTH_ALPHA * (rawAz_mg / 1000.0f) + (1.0f - ACCEL_SMOOTH_ALPHA) * accelZ;
    gyroX = rawGx - USER_GYRO_BIAS_X;
    gyroY = rawGy - USER_GYRO_BIAS_Y;
    gyroZ = rawGz - USER_GYRO_BIAS_Z;

    float gyroMag = vecMagG(gyroX, gyroY, gyroZ);
    float dropped = gyroMagBuf[gyroWinIdx];
    gyroSumsq -= dropped * dropped;
    gyroMagBuf[gyroWinIdx] = gyroMag;
    gyroSumsq += gyroMag * gyroMag;
    gyroWinIdx = (gyroWinIdx + 1) % GYRO_WIN_N;
    if (gyroCountWin < GYRO_WIN_N) gyroCountWin++;
    global_gyro_rms = (gyroCountWin > 0) ? sqrtf(gyroSumsq / gyroCountWin) : 0.0f;

    if (ActivityState == ACT_REST) {
        if (global_gyro_rms > ACT_TH_UP) {
            actUpCnt++;
            if (actUpCnt >= ACT_DEBOUNCE_COUNT) {
                ActivityState = ACT_MOTION;
                actUpCnt = 0;
                stableBPM = reliableBPM;
                stableSBP = currentSBP;
                stableDBP = currentDBP;
                stableRR = currentRR;
            }
        } else { actUpCnt = 0; }
    } else {
        if (global_gyro_rms < ACT_TH_DOWN) {
            actDownCnt++;
            if (actDownCnt >= ACT_DEBOUNCE_COUNT) {
                ActivityState = ACT_REST;
                actDownCnt = 0;
            }
        } else { actDownCnt = 0; }
    }
    
    return true;
}

// --- ADVANCED FALL DETECTION & RECOVERY ---
void processFallAndRecovery(const float fA[3], const float fG[3]) {
    if (!system_status.imu_ok) return;
    
    unsigned long now = millis();
    pushRing(fA[0], fA[1], fA[2], now);
    float accMag = vecMagG(fA[0], fA[1], fA[2]);
    float gyroMag = vecMagG(fG[0], fG[1], fG[2]);

    if (now - lastFallReportMs < FALL_LOCKOUT_MS) return;

    switch (fallState) {
        case IDLE:
             if (accMag < FREEFALL_THRESH_G || (gyroMag > FREEFALL_SPIN_GYRO_DPS && accMag < FREEFALL_SPIN_MAX_ACC_G)) {
                fallState = MAYBE_FREEFALL;
                freefallStartTs = now;
            }
            break;
        case MAYBE_FREEFALL:
            if (accMag < FREEFALL_THRESH_G || (gyroMag > FREEFALL_SPIN_GYRO_DPS && accMag < FREEFALL_SPIN_MAX_ACC_G)) {
                if (now - freefallStartTs >= FREEFALL_MIN_MS) {
                    accelBeforeImpact = avgRingBetween((freefallStartTs > 50 ? freefallStartTs - 50 : 0), freefallStartTs + 20);
                    lastFreefallTs = freefallStartTs;
                }
            } else {
                if (accMag > IMPACT_THRESH_G || accMag > IMPACT_MIN_PEAK_G) {
                    impactTs = now;
                    fallState = IMPACT_DETECTED;
                } else if (now - freefallStartTs > MAX_FREEFALL_TO_IMPACT_MS) {
                    lastFreefallTs = 0;
                    fallState = IDLE;
                }
            }
            break;
        case IMPACT_DETECTED:
            accelAfterImpact = avgRingBetween(impactTs, impactTs + 100);
            if (gyroMag > GYRO_SPIKE_THRESHOLD_DPS && (lastFreefallTs != 0) && ((now - lastFreefallTs) <= MAX_FREEFALL_TO_IMPACT_MS)) {
                fallState = CONFIRMING_FALL;
                confirmHoldStart = 0;
            } else {
                fallState = IDLE;
            }
            break;
        case CONFIRMING_FALL:
            float tiltDeg = angleDegBetweenVecsSafe(accelBeforeImpact, accelAfterImpact);
            if (ActivityState == ACT_REST && tiltDeg > TILT_IMMEDIATE_DEG) {
                if (confirmHoldStart == 0) confirmHoldStart = now;

                if (now - confirmHoldStart >= CONFIRM_HOLD_MS) {
                    fallActive = true;
                    fallDetectedTs = now;
                    fallRecoveryState = REC_WAITING;
                    lastFallReportMs = now;
                    Serial.println("[ALERT] Fall detected! -> Recovery state: WAITING");
                    fallState = IDLE;
                }
            } else {
                 confirmHoldStart = 0;
            }
            if (now - impactTs > POST_IMPACT_WINDOW_MS) {
                 fallState = IDLE;
            }
            break;
    }

    if (fallActive) {
        if ((now - fallDetectedTs) > RECOVERY_TIMEOUT_MS) {
            fallRecoveryState = REC_TIMEOUT;
            fallActive = false;
            fallOutputUntil = now + 6000UL; 
            Serial.println("[RECOVERY] Timeout. Escalating alert.");
            return;
        }

        Vec3 currentGravity = avgRingBetween((now > 400 ? now - 400 : 0), now);
        float currentTiltDeg = angleDegBetweenVecsSafe(baselineGravity, currentGravity);
        bool isMotion = global_gyro_rms > RECOVERY_MOTION_GYRO;
        bool isQuiet = global_gyro_rms < RECOVERY_GYRO_QUIET;

        switch (fallRecoveryState) {
            case REC_WAITING:
                if (isMotion || currentTiltDeg <= RECOVERY_STAGE1_TILT_DEG) {
                    fallRecoveryState = REC_ATTEMPT;
                    recoveryMotionTs = now;
                    recoveryTiltAtMotionStart = currentTiltDeg;
                    recoveryStartedByTilt = !isMotion;
                    Serial.println("[RECOVERY] Motion/Tilt detected -> state: ATTEMPT");
                }
                break;
            case REC_ATTEMPT: {
                float tiltDrop = recoveryTiltAtMotionStart - currentTiltDeg;
                bool motionSustained = (now - recoveryMotionTs) > RECOVERY_MIN_MOTION_MS;
                
                if (currentTiltDeg <= RECOVERY_STAGE2_TILT_DEG && isQuiet && (motionSustained || tiltDrop > RECOVERY_MIN_TILT_DROP_DEG)) {
                    if (recoveryStableStart == 0) {
                        recoveryStableStart = now;
                    }
                    if ((now - recoveryStableStart) >= RECOVERY_SUSTAIN_MS) {
                        fallRecoveryState = REC_CONFIRMED;
                        fallActive = false;
                        fallOutputUntil = now + 6000UL;
                        Serial.println("[RECOVERY] Stable upright position detected -> state: CONFIRMED!");
                    }
                } else {
                    recoveryStableStart = 0;
                }
                break;
            }
            default:
                break;
        }
    }
}


// --- ECG ---
void resetECGSystem() {
    isCalibrated = false;
    calibrationCount = 0;
    lastBeatTime = 0;
    refractoryEndTime = 0;
    for (int i=0; i<8; ++i) bpmBuffer[i] = 0;
    bpmIndex = 0;
    reliableBPM = 0;
    currentSBP = 0; currentDBP = 0; currentRR = 0;
    dynamicThreshold = 2048;
    Serial.println("[INFO] ECG system reset.");
}

bool checkElectrodeConnection() {
    bool loPlus = digitalRead(LO_PLUS_PIN);
    bool loMinus = digitalRead(LO_MINUS_PIN);
    bool rawConnectionIsBad = loPlus || loMinus;
    unsigned long now = millis();

    if (rawConnectionIsBad) {
        if (!isCurrentlyDisconnected) {
            disconnectStartTime = now;
            isCurrentlyDisconnected = true;
        }
        if (now - disconnectStartTime > LEAD_OFF_DEBOUNCE_MS) {
            system_status.ecg_electrodes_ok = false;
        }
    } else {
        isCurrentlyDisconnected = false;
        system_status.ecg_electrodes_ok = true;
    }
    return system_status.ecg_electrodes_ok;
}

void updateDynamicThreshold() {
    if (!isCalibrated) return;
    int minVal = 4095, maxVal = 0;
    for (int i = 0; i < PEAK_WINDOW; i++) {
        if (recentSamples[i] < minVal) minVal = recentSamples[i];
        if (recentSamples[i] > maxVal) maxVal = recentSamples[i];
    }
    int signalRange = maxVal - minVal;
    dynamicThreshold = (signalRange > MIN_SIGNAL_RANGE) 
        ? currentBaseline + (int)(signalRange * PEAK_THRESHOLD_RATIO) 
        : currentBaseline + MIN_PEAK_HEIGHT;
}

bool robustBeatDetection(int ecgValue) {
    static int maxPeakInRegion = 0;
    static bool inPeakRegion = false;

    if (ecgValue > dynamicThreshold) {
        if (!inPeakRegion) {
            inPeakRegion = true;
            maxPeakInRegion = ecgValue;
        } else {
            if (ecgValue > maxPeakInRegion) maxPeakInRegion = ecgValue;
        }
    } else {
        if (inPeakRegion) {
            inPeakRegion = false;
            if (maxPeakInRegion > currentBaseline + MIN_PEAK_HEIGHT) {
                lastPeakValue = maxPeakInRegion;
                return true;
            }
        }
    }
    return false;
}

int processECG() {
    static bool wasConnected = true;
    if (!checkElectrodeConnection()) {
        if (wasConnected) {
             Serial.println("[WARN] ECG electrodes disconnected. Resetting ECG data.");
             resetECGSystem();
             wasConnected = false;
        }
        return 0;
    }
    if (!wasConnected) {
        Serial.println("[INFO] ECG electrodes reconnected.");
        wasConnected = true;
    }

    int rawECG = analogRead(ECG_OUTPUT_PIN);
    int filteredECG = (recentSamples[sampleIndex] + rawECG) / 2;
    
    recentSamples[sampleIndex] = filteredECG;
    sampleIndex = (sampleIndex + 1) % PEAK_WINDOW;
    baselineBuffer[baselineIndex] = filteredECG;
    baselineIndex = (baselineIndex + 1) % BASELINE_WINDOW;

    long sum = 0;
    for(int i=0; i<BASELINE_WINDOW; i++) sum += baselineBuffer[i];
    currentBaseline = sum / BASELINE_WINDOW;

    if (!isCalibrated) {
        calibrationCount++;
        if (calibrationCount >= CALIBRATION_SAMPLES) {
            isCalibrated = true;
            updateDynamicThreshold();
            Serial.println("[OK] ECG calibration complete. Beat detection active.");
        }
        return rawECG;
    }

    unsigned long now = millis();
    if (now > refractoryEndTime && ActivityState == ACT_REST) {
        if (robustBeatDetection(filteredECG)) {
            unsigned long interval = (lastBeatTime > 0) ? (now - lastBeatTime) : 0;
            if (interval > MIN_BEAT_INTERVAL) {
                 float instantBPM = 60000.0f / interval;
                 if (instantBPM > 40 && instantBPM < 200) {
                    bpmBuffer[bpmIndex] = instantBPM;
                    bpmIndex = (bpmIndex + 1) % 8;
                 }
            }
            lastBeatTime = now;
            refractoryEndTime = now + REFRACTORY_PERIOD;
        }
    }

    float sum_bpm = 0; int count = 0;
    for(int i=0; i<8; i++) {
        if (bpmBuffer[i] > 0) {
            sum_bpm += bpmBuffer[i];
            count++;
        }
    }
    if (count > 0) reliableBPM = sum_bpm / count;
    
    if (now - lastThreshUpdate > 500) {
        updateDynamicThreshold();
        lastThreshUpdate = now;
    }
    return rawECG;
}


// --- OTHER SENSORS & VITALS ---
void updateTemperature() {
    if (!system_status.temp_sensor_ok) return;
    sensors_event_t temp;
    tmp117.getEvent(&temp);
    if (temp.temperature < -50 || temp.temperature > 150) {
        Serial.println("[WARN] Invalid temperature reading, disabling sensor.");
        system_status.temp_sensor_ok = false;
        currentTemperature = 0;
    } else {
        currentTemperature = temp.temperature;
    }
}

void updateVitalsFromBPM() {
    // LOGIC FIX: If BPM is 0, all derived vitals must also be 0.
    if (reliableBPM == 0) {
        currentSBP = 0;
        currentDBP = 0;
        currentRR = 0;
        return;
    }
    if (reliableBPM < vitals_table[0].hr) {
        currentSBP = vitals_table[0].sbp;
        currentDBP = vitals_table[0].dbp;
        currentRR = vitals_table[0].rr;
        return;
    }
    if (reliableBPM >= vitals_table[VITALS_TABLE_SIZE-1].hr) {
        currentSBP = vitals_table[VITALS_TABLE_SIZE-1].sbp;
        currentDBP = vitals_table[VITALS_TABLE_SIZE-1].dbp;
        currentRR = vitals_table[VITALS_TABLE_SIZE-1].rr;
        return;
    }
    
    int lower_idx = 0;
    for (int i = 0; i < VITALS_TABLE_SIZE - 1; i++) {
        if (reliableBPM >= vitals_table[i].hr && reliableBPM < vitals_table[i + 1].hr) {
            lower_idx = i;
            break;
        }
    }

    currentSBP = lerp(vitals_table[lower_idx].hr, vitals_table[lower_idx].sbp, vitals_table[lower_idx+1].hr, vitals_table[lower_idx+1].sbp, reliableBPM);
    currentDBP = vitals_table[lower_idx].dbp;
    currentRR  = lerp(vitals_table[lower_idx].hr, vitals_table[lower_idx].rr, vitals_table[lower_idx+1].hr, vitals_table[lower_idx+1].rr, reliableBPM);
}

void updateEmergencyButton() {
    static int lastButtonState = HIGH;
    if (millis() - lastButtonCheck > BUTTON_DEBOUNCE_MS) {
        int currentButtonState = digitalRead(EMERGENCY_BTN_PIN);
        if (lastButtonState == HIGH && currentButtonState == LOW) {
            // A press has been detected
            emergencyActiveState = !emergencyActiveState;
        }
        lastButtonState = currentButtonState;
        lastButtonCheck = millis();
    }
    emergencyPressed = emergencyActiveState;
}

// --- SENSOR RECOVERY HANDLER ---
void handleSensorRecovery() {
    unsigned long now = millis();
    if (now - lastSensorCheck > SENSOR_CHECK_INTERVAL_MS) {
        lastSensorCheck = now;

        if (!system_status.imu_ok) {
            Serial.println("[INFO] Attempting to recover IMU sensor...");
            initializeIMU();
        }
        if (!system_status.temp_sensor_ok) {
            Serial.println("[INFO] Attempting to recover Temp sensor...");
            initializeTempSensor();
        }
    }
}

// ========================================================================
// SETUP & MAIN LOOP
// ========================================================================

void setup() {
    Serial.begin(115200);
    // while (!Serial) { delay(1); } // Commented out for battery-powered operation

    Serial.println("\n========================================");
    Serial.println("Complete Health Monitor v9.5 - UPGRADED FALL ENGINE");
    Serial.println("========================================");

    pinMode(LO_PLUS_PIN, INPUT_PULLUP);
    pinMode(LO_MINUS_PIN, INPUT_PULLUP);
    pinMode(EMERGENCY_BTN_PIN, INPUT_PULLUP);

    initializeESPNOW();
    initializeIMU();
    initializeTempSensor();
    
    tx_state.system_start_time = millis();

    Serial.println("[INFO] System setup complete. Starting main loop.");
    Serial.println("[INFO] First 60 seconds is calibration period. No data will be sent.");
}

void loop() {
    unsigned long now = millis();
    if (now - lastMs < SAMPLE_MS) return;
    lastMs = now;

    handleSensorRecovery();

    static float ax=0, ay=0, az=0, gx=0, gy=0, gz=0;
    if (processIMU(ax, ay, az, gx, gy, gz)) {
        float fA[3] = {ax, ay, az};
        float fG[3] = {gx, gy, gz};
        processFallAndRecovery(fA, fG);
    }

    int ecg_raw_value = processECG();
    
    updateTemperature();
    updateEmergencyButton();
    updateVitalsFromBPM();
    
    float bpm_to_add = (ActivityState == ACT_MOTION) ? stableBPM : reliableBPM;
    float sbp_to_add = (ActivityState == ACT_MOTION) ? stableSBP : currentSBP;
    float dbp_to_add = (ActivityState == ACT_MOTION) ? stableDBP : currentDBP;
    float rr_to_add = (ActivityState == ACT_MOTION) ? stableRR : currentRR;
    addToAveragingBuffers(bpm_to_add, sbp_to_add, dbp_to_add, rr_to_add, currentTemperature);
    
    handleDataTransmission();

    if (now - lastDebugPrint > 1000) {
        printResults(ecg_raw_value);
        lastDebugPrint = now;
    }

    delay(1); // Crucial delay to yield CPU time to the WiFi/ESP-NOW stack
}

// --- UTILITY ---
int compareInts(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

void printResults(int rawECG) {
    Serial.print("ECG Raw: "); Serial.print(rawECG);
    Serial.print(" | Thresh: "); Serial.print(dynamicThreshold);
    Serial.print(" | BPM: "); Serial.print((int)reliableBPM);
    Serial.print(" | BP: "); Serial.print((int)currentSBP);
    Serial.print("/"); Serial.print((int)currentDBP);
    Serial.print(" | RR: "); Serial.print((int)currentRR);
    Serial.print(" | Temp: "); Serial.print(currentTemperature, 1);
    Serial.print(" | LO: "); Serial.print(system_status.ecg_electrodes_ok ? 0 : 1);
    Serial.print(" | Motion: "); Serial.print(ActivityState == ACT_MOTION ? 1 : 0);
    
    Serial.print(" | Fall: ");
    if (fallActive) Serial.print("ACTIVE");
    else if (fallOutputUntil > millis()) {
        if (fallRecoveryState == REC_CONFIRMED) Serial.print("RECOVERED");
        else if (fallRecoveryState == REC_TIMEOUT) Serial.print("TIMEOUT");
        else Serial.print("NORMAL");
    } else Serial.print("NORMAL");
    
    Serial.print(" | Recovery: ");
    switch(fallRecoveryState) {
        case REC_WAITING: Serial.print("WAITING"); break;
        case REC_ATTEMPT: Serial.print("ATTEMPT"); break;
        case REC_CONFIRMED: Serial.print("CONFIRMED"); break;
        case REC_TIMEOUT: Serial.print("TIMEOUT"); break;
        default: Serial.print("NONE"); break;
    }
    
    Serial.print(" | EMG: "); Serial.print(emergencyPressed ? 1 : 0);
    Serial.println();
}
