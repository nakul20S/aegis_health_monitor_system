void initializeESPNOW() {
    WiFi.mode(WIFI_STA);
    WiFi.setTxPower(WIFI_POWER_11dBm);

    Serial.print("[INFO] MAC Address: ");
    Serial.println(WiFi.macAddress());
    if (esp_now_init() != ESP_OK) {
        Serial.println("[FATAL] ESP-NOW init failed. Halting.");
        while (true);
    }
    esp_now_peer_info_t peer = {};
    memcpy(peer.peer_addr, receiverMAC, 6);
    if (esp_now_add_peer(&peer) != ESP_OK) {
        Serial.println("[FATAL] Failed to add ESP-NOW peer. Halting.");
        while (true);
    }
    Serial.println("[OK] ESP-NOW initialized successfully.");
}

void initializeIMU() {
    Wire.begin(SDA_PIN, SCL_PIN);
    Wire.setClock(I2C_CLOCK);
    if (myICM.begin(Wire, I2C_AD0_ARG) != ICM_20948_Stat_Ok) {
        Serial.println("[FAIL] ICM-20948 (IMU) init failed. Motion/Fall detection disabled.");
        system_status.imu_ok = false;
    } else {
        ICM_20948_fss_t fss;
        fss.a = gpm4; fss.g = dps500;
        myICM.setFullScale((ICM_20948_Internal_Gyr | ICM_20948_Internal_Acc), fss);
        myICM.enableDMP(false);
        system_status.imu_ok = true;
        Serial.println("[OK] ICM-20948 (IMU) initialized.");
    }
}

void initializeTempSensor() {
    if (!tmp117.begin()) {
        Serial.println("[FAIL] TMP117 (Temp) sensor not found. Temperature monitoring disabled.");
        system_status.temp_sensor_ok = false;
    } else {
        system_status.temp_sensor_ok = true;
        Serial.println("[OK] TMP117 (Temp) sensor initialized.");
    }
}

